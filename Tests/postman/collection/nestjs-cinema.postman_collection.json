				{
					"name": "GP-014 - Cenários para exclusão de reservas de ingressos",
					"item": [
						{
							"name": "CT-035 - Excluir reserva de ingresso com sucesso",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const url = pm.environment.get('base_url');\r",
											"if (!url) {\r",
											"    console.error('A variável de ambiente \"base_url\" não está definida.');\r",
											"    return;\r",
											"}\r",
											"\r",
											"const nomeUsuario = pm.variables.replaceIn('{{$randomFullName}}');\r",
											"const movieId = `movie_${Math.floor(Math.random() * 10000)}`;  \r",
											"const userId = `user_${Math.floor(Math.random() * 10000)}`;   \r",
											"const seatNumber = Math.floor(Math.random() * 99) + 1;         \r",
											"const price = Math.floor(Math.random() * 50) + 10;             \r",
											"const showtime = new Date().toISOString();                      \r",
											"\r",
											"pm.environment.set('nomeUsuario', nomeUsuario);\r",
											"pm.environment.set('movieId', movieId);\r",
											"pm.environment.set('userId', userId);\r",
											"pm.environment.set('seatNumber', seatNumber);\r",
											"pm.environment.set('price', price);\r",
											"pm.environment.set('showtime', showtime);\r",
											"\r",
											"const postRequestTicket = {\r",
											"    url: `${url}/tickets`,  \r",
											"    method: 'POST',\r",
											"    header: {\r",
											"        'Content-Type': 'application/json',\r",
											"    },\r",
											"    body: {\r",
											"        mode: 'raw',\r",
											"        raw: JSON.stringify({\r",
											"            \"movieId\": movieId,\r",
											"            \"userId\": userId,\r",
											"            \"seatNumber\": seatNumber,\r",
											"            \"price\": price,\r",
											"            \"showtime\": showtime\r",
											"        })\r",
											"    }\r",
											"};\r",
											"\r",
											"pm.sendRequest(postRequestTicket, (err, response) => {\r",
											"    if (err) {\r",
											"        console.error('Erro ao criar o ticket:', err);\r",
											"        return;\r",
											"    }\r",
											"\r",
											"    const resTicket = response.json();\r",
											"    console.log('Resposta do ticket:', resTicket);\r",
											"\r",
											"    if (!resTicket._id) {\r",
											"        console.warn('Falha ao criar o ticket - ID não retornado.');\r",
											"        return;\r",
											"    }\r",
											"\r",
											"    pm.environment.set('ticketId', resTicket._id);\r",
											"});\r",
											""
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "DELETE",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "",
									"options": {
										"raw": {
