						{
							"name": "CT-044 - Criar filme com titulo duplicado",
							"event": [
								{
									"listen": "prerequest",
									"script": {
										"exec": [
											"const url = pm.environment.get('base_url');\r",
											"if (!url) {\r",
											"    console.error('A variável de ambiente \"base_url\" não está definida.');\r",
											"    return;\r",
											"}\r",
											"\r",
											"const filme = {\r",
											"    title: \"titulo\",\r",
											"    description: \"string\",\r",
											"    launchdate: \"2025-01-09T16:40:45.398Z\",\r",
											"    showtimes: [\"string\"]\r",
											"};\r",
											"\r",
											"const postRequestFilme = {\r",
											"    url: `${url}/movies`,\r",
											"    method: 'POST',\r",
											"    header: {\r",
											"        'Content-Type': 'application/json',\r",
											"    },\r",
											"    body: {\r",
											"        mode: 'raw',\r",
											"        raw: JSON.stringify(filme)\r",
											"    }\r",
											"};\r",
											"\r",
											"pm.sendRequest(postRequestFilme, (err, response) => {\r",
											"    if (err) {\r",
											"        console.error('Erro ao cadastrar o filme:', err);\r",
											"        return;\r",
											"    }\r",
											"\r",
											"\r",
											"});\r",
											""
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n  \"title\": \"titulo\",\r\n  \"description\": \"string\",\r\n  \"launchdate\": \"2025-01-09T16:40:45.398Z\",\r\n  \"showtimes\": [\r\n    \"string\"\r\n  ]\r\n}\r\n",
